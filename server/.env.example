# MongoDB Atlas connection string (replace the placeholders; do not commit server/.env).
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Use a long, randomly generated value in production.
JWT_SECRET=replace-with-a-long-random-secret

# Provided by the Vercel Blob store connected to this Vercel project.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_example
ADMIN_NAME=Site Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
